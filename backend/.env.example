# Copy this file to `.env` (which is gitignored) and fill in your real key:
#
#   cp .env.example .env
#   # then edit .env and set the key
#
# `npm run smoke:live` loads backend/.env automatically (via
# --env-file-if-exists). Alternatively, export the variable in your shell and
# skip the .env file entirely:
#
#   export ANTHROPIC_API_KEY=sk-ant-...
#
# Never commit your real key. `.env` is gitignored; this `.env.example` is not
# and must stay empty.
ANTHROPIC_API_KEY=
